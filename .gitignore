# Byte-compiled / caches
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Runtime artifacts
tmp/
screenshots/*
!screenshots/.gitkeep
*.jpg
*.jpeg
*.png
!assets/**
!screenshots/.gitkeep

# IDE / OS
.DS_Store
.idea/
.vscode/
.streamlit/secrets.toml

# Large model weights — download via: python scripts/download_model.py
# Do NOT commit .pt files (GitHub limit = 100 MB)
*.pt
models/**/*.pt
!models/.gitkeep
yolov8*.pt
yolo11*.pt
